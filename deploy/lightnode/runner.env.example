XMCL_LIGHTNODE_RUNNER_ADDR=127.0.0.1:8088
XMCL_LIGHTNODE_RUNNER_STATE_ROOT=/var/lib/xmcl-lightnode-runner
XMCL_LIGHTNODE_RUNNER_SECRET=
XMCL_LIGHTNODE_RUNNER_APPROVAL_SECRET=

XMCL_LIGHTNODE_RUNNER_SCRIPT=/opt/xmcl-lightnode-runner/runner.sh
XMCL_LIGHTNODE_BOOTSTRAP_SCRIPT=/opt/xmcl-lightnode-runner/bootstrap.sh
XMCL_LIGHTNODE_AGENT_SERVICE=/opt/xmcl-lightnode-runner/xmcl-shared-node-agent.service
XMCL_LIGHTNODE_PRIVATE_KEY=/run/secrets/xmcl-lightnode-bootstrap-key
XMCL_LIGHTNODE_SSH_USER=ubuntu
XMCL_LIGHTNODE_SSH_PORT=22
