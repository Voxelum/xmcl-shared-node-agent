# Upload this file to /run/xmcl-lightnode-bootstrap.env with owner root:root
# and mode 0600. Never persist a populated copy in source control.
XMCL_NODE_ID=node-example
XMCL_INSTANCE_ID=ecs-example
XMCL_REGION=mow
XMCL_CONTROL_PLANE_URL=https://api-staging.xmcl.app
XMCL_ENROLLMENT_TOKEN=
XMCL_INGRESS_HOST=203.0.113.10

XMCL_OBJECT_STORAGE_ENDPOINT=https://objects.example.com
XMCL_OBJECT_STORAGE_REGION=region-id
XMCL_OBJECT_STORAGE_BUCKET=xmcl-shared-hosting

XMCL_RELEASE_MANIFEST_URL=https://github.com/Voxelum/xmcl-shared-node-agent/releases/download/v0.1.0/release-manifest.json
XMCL_RELEASE_MANIFEST_SHA256=

# This must be an exact version visible through apt-cache policy docker.io on
# the selected, immutable Ubuntu 24.04 LightNode image.
XMCL_DOCKER_PACKAGE_VERSION=

XMCL_TOTAL_MEMORY_MIB=14336
XMCL_TOTAL_SHARED_CPU=8
XMCL_TOTAL_WORKSPACE_GIB=32
# The XFS loopback volume is disposable cache on the VM system disk. Leave
# enough system-disk headroom for Ubuntu, Docker, images, logs, and sync staging.
XMCL_WORKSPACE_VOLUME_GIB=40
XMCL_BOOTSTRAP_TIMEOUT_SECONDS=600
