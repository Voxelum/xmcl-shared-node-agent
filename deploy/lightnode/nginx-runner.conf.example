server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name runner.example.com;

    ssl_certificate /etc/letsencrypt/live/runner.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/runner.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 32k;

    location = /v1/bootstrap-jobs {
        limit_except POST {
            deny all;
        }

        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 1900s;
    }

    location ~ "^/v1/bootstrap-jobs/[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}/(status|approve)$" {
        allow 127.0.0.1;
        allow ::1;
        deny all;

        limit_except POST {
            deny all;
        }

        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location / {
        return 404;
    }
}
