[Unit]
Description=XMCL shared runtime compiler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=10001
Group=10001
WorkingDirectory=/opt/xmcl-compiler/app
ExecStart=/usr/bin/node /opt/xmcl-compiler/app/src/worker-server.mjs
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8080
LoadCredential=service-hmac-secret:/etc/xmcl-compiler/service-hmac-secret
RuntimeDirectory=xmcl-compiler/workspaces
RuntimeDirectoryMode=0700
StateDirectory=xmcl-compiler/replay xmcl-compiler/jobs
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
ReadOnlyPaths=/etc/xmcl-compiler /opt/xmcl-compiler /opt/xmcl/jres
ReadWritePaths=/run/xmcl-compiler/workspaces /var/lib/xmcl-compiler/replay /var/lib/xmcl-compiler/jobs
MemoryMax=3200M
MemorySwapMax=0
TasksMax=512
CPUQuota=200%
LimitNOFILE=65536
LimitNPROC=512

[Install]
WantedBy=multi-user.target
